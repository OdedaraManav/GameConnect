// Prisma schema for GameConnect
// PostgreSQL database

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id              Int      @id
  name            String
  genre           String
  rating          Float
  reviewsCount    String
  platforms       String[]
  image           String
  description     String
  featuredTag     String
  releaseDate     String
  developer       String
  publisher       String
  fullDescription String
  screenshots     String[]

  favoritedBy     UserFavoriteGame[]
  playedBy        UserPlayingGame[]
}

model Player {
  id                  Int      @id
  username            String
  avatar              String
  games               String[]
  skillLevel          String
  playstyle           String
  platform            String
  availability        String
  onlineHours         String
  matchPercentage     Int
  region              String
  status              String
  bio                 String

  compatibility       Json

  favoriteGameIds     Int[]
  currentlyPlayingIds Int[]
  commonGames         String[]

  preferences         Json
}

model User {
  id                Int      @id @default(autoincrement())
  username          String   @unique
  email             String   @unique
  password          String
  avatar            String   @default("https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=300&q=80")
  bio               String   @default("Gamer on GameConnect! Ready for squad matches and casual play.")
  location          String   @default("Asia / India")
  platform          String   @default("PC")
  playstyle         String   @default("Casual & Competitive")
  availability      String   @default("8:00 PM – 12:00 AM")
  availabilityStart String   @default("20:00")
  availabilityEnd   String   @default("00:00")
  status            String   @default("Online")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  favoriteGames     UserFavoriteGame[]
  playingGames      UserPlayingGame[]
}

model UserFavoriteGame {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

model UserPlayingGame {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}