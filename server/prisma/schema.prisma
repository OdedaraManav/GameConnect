// Prisma schema for GameConnect
// PostgreSQL database

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id              Int      @id
  name            String
  genre           String
  rating          Float
  reviewsCount    String
  platforms       String[]
  image           String
  description     String
  featuredTag     String
  releaseDate     String
  developer       String
  publisher       String
  fullDescription String
  screenshots     String[]

  favoritedBy     UserFavoriteGame[]
  playedBy        UserPlayingGame[]
  userProfiles    UserGameProfile[]
}

model Player {
  id                  Int      @id
  username            String
  avatar              String
  games               String[]
  skillLevel          String
  playstyle           String
  platform            String
  availability        String
  onlineHours         String
  matchPercentage     Int
  region              String
  status              String
  bio                 String

  compatibility       Json

  favoriteGameIds     Int[]
  currentlyPlayingIds Int[]
  commonGames         String[]

  preferences         Json
}

model User {
  id                Int      @id @default(autoincrement())
  username          String   @unique
  email             String   @unique
  password          String
  avatar            String   @default("https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=300&q=80")
  bio               String   @default("Gamer on GameConnect! Ready for squad matches and casual play.")
  location          String   @default("Asia / India")
  platform          String   @default("PC")
  playstyle         String   @default("Casual & Competitive")
  availability      String   @default("8:00 PM – 12:00 AM")
  availabilityStart String   @default("20:00")
  availabilityEnd   String   @default("00:00")
  status            String   @default("Online")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  favoriteGames     UserFavoriteGame[]
  playingGames      UserPlayingGame[]
  gameProfiles      UserGameProfile[]

  sentRequests      FriendRequest[]    @relation("SentRequests")
  receivedRequests  FriendRequest[]    @relation("ReceivedRequests")
  friendshipsA      Friendship[]       @relation("FriendshipUserA")
  friendshipsB      Friendship[]       @relation("FriendshipUserB")
  sentBlocks        UserBlock[]        @relation("SentBlocks")
  receivedBlocks    UserBlock[]        @relation("ReceivedBlocks")
}

model UserFavoriteGame {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

model UserPlayingGame {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
}

enum VerificationStatus {
  SELF_REPORTED
  VERIFIED
}

model UserGameProfile {
  id                 Int                @id @default(autoincrement())
  userId             Int
  gameId             Int

  // Identity & Public Identifiers (Not credentials)
  gamerTag           String
  gameAccountId      String?

  // Progression & Attributes
  rank               String?
  tier               String?
  level              Int?
  platform           String?
  region             String?

  // Game-Specific Statistics (Flexible JSON for stats ONLY)
  stats              Json?

  // Connection & Verification States (Separated)
  isAccountConnected Boolean            @default(false)
  verificationStatus VerificationStatus @default(SELF_REPORTED)

  // Audit Metadata (Server-managed)
  verifiedAt         DateTime?
  lastSyncedAt       DateTime?
  verificationSource String?

  // System Timestamps
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
  @@index([gameId])
  @@index([verificationStatus])
}

enum RequestStatus {
  PENDING
  REJECTED
}

model FriendRequest {
  id         Int           @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userAId   Int
  userBId   Int
  createdAt DateTime @default(now())

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("SentBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("ReceivedBlocks", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}